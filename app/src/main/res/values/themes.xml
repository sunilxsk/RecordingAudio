<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string name="app_name">RecordingAudio</string>
    <string name="notification_capture_title">正在内录音频</string>
    <string name="notification_capture_text">点击停止并保存录音</string>
    <string name="notification_float_title">悬浮球已就绪</string>
    <string name="notification_float_text">点按开始/暂停，长按结束并保存</string>

    <color name="ic_launcher_background">#1E88E5</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
